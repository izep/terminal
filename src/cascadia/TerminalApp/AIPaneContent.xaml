<UserControl x:Class="TerminalApp.AIPaneContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mtu="using:Microsoft.Terminal.UI"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="PageBackground">#282828</Color>
                    <Color x:Key="UserBubbleBackground">#1E3A5F</Color>
                    <Color x:Key="AssistantBubbleBackground">#2D2D2D</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="PageBackground">#F9F9F9</Color>
                    <Color x:Key="UserBubbleBackground">#CCE4FF</Color>
                    <Color x:Key="AssistantBubbleBackground">#EEEEEE</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="PageBackground"
                                    ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="UserBubbleBackground"
                                    ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="AssistantBubbleBackground"
                                    ResourceKey="SystemColorWindowColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{ThemeResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Title bar  -->
            <RowDefinition Height="*" />
            <!--  Message history  -->
            <RowDefinition Height="Auto" />
            <!--  Input area  -->
        </Grid.RowDefinitions>

        <!--  Title bar  -->
        <Grid Grid.Row="0"
              Padding="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      FontSize="14"
                      Foreground="{ThemeResource SystemAccentColor}"
                      Glyph="&#xe946;" />
            <!--  Sparkle icon  -->

            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Text="AI Chat" />

            <Button Grid.Column="2"
                    Width="28"
                    Height="28"
                    Padding="4"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="_closeClicked"
                    ToolTipService.ToolTip="Close (Esc)">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="12"
                          Glyph="&#xe8bb;" />
            </Button>
        </Grid>

        <!--  Message history  -->
        <ScrollViewer x:Name="MessageScrollViewer"
                      Grid.Row="1"
                      Padding="8,4"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled">
            <StackPanel x:Name="MessageList"
                        Spacing="8" />
        </ScrollViewer>

        <!--  Input area  -->
        <Grid Grid.Row="2"
              Padding="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputBox"
                     Grid.Column="0"
                     MinHeight="32"
                     MaxHeight="120"
                     Padding="8,6"
                     AcceptsReturn="True"
                     KeyDown="_inputKeyDown"
                     PlaceholderText="Ask a question… (Enter to send, Shift+Enter for newline)"
                     TextWrapping="Wrap">
                <TextBox.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBox.ContextFlyout>
            </TextBox>

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    Margin="4,0,0,0"
                    Padding="6"
                    Click="_sendClicked"
                    IsEnabled="{x:Bind IsIdle, Mode=OneWay}"
                    ToolTipService.ToolTip="Send (Enter)">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14"
                          Glyph="&#xe724;" />
                <!--  Send icon  -->
            </Button>
        </Grid>
    </Grid>
</UserControl>
